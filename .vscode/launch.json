      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "NOEMA_MODEL_DIR": "../Models",
        "NOEMA_VERBOSE": "1",
        "NOEMA_CONTEXT_SIZE": "8192",
