{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Noema: basics",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv-metal/bin/python",
      "program": "${workspaceFolder}/examples/basics.py",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "NOEMA_MODEL_DIR": "../Models",
        "NOEMA_VERBOSE": "1",
        "NOEMA_CONTEXT_SIZE": "8192",
        "NOEMA_N_GPU_LAYERS": "-1",
        "NOEMA_ENABLE_MONITORING": "0",
        "NOEMA_SUPPRESS_STARTUP_LOGS": "1",
        "NOEMA_FAST_EXIT": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Noema: comment classifier",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/.venv-metal/bin/python",
